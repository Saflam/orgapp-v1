+            'event_id' => $event->id,
+            'event_participant_id' => $participant->id,
+            'token_hash' => hash('sha256', bin2hex(random_bytes(32))),
+            'status' => 'active',
+            'capacity' => 1,
+            'current_inside' => 0,
+            'issued_at' => now(),
+            'issued_by' => $user->id,
