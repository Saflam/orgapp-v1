+
+        EventAttendanceScan::query()->create([
+            'organization_id' => $organization->id,
+            'event_id' => $event->id,
+            'event_pass_id' => $pass->id,
+            'scanned_by' => $user->id,
+            'action' => 'entry',
+            'quantity' => 1,
+            'scanned_at' => now(),
+        ]);
+    }
